# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# The site runs WITHOUT any of these. With no credentials, or with credentials
# that fail, it renders the local seed content in src/content/seed.ts, so it
# always builds and always deploys.
#
# `npx sanity@5 init --env=.env.local` writes the first two for you.
# (Note the "=": --env takes the filename as a value. Pin to 5: the installed
# sanity package is 5.x, and a newer CLI rewrites src/sanity/env.ts.)
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-06

# ---------------------------------------------------------------------------
# REQUIRED IF YOUR DATASET IS PRIVATE.
#
# A private dataset rejects unauthenticated reads, so without this every query
# returns 401 and the site quietly falls back to seed content, and it will look
# like the CMS "isn't working" while everything reports healthy.
#
# Create one at sanity.io/manage → your project → API → Tokens, with Viewer
# permission. Deliberately NOT prefixed NEXT_PUBLIC_, so it stays server-side;
# that is safe because pages are statically generated and revalidated on the
# server and nothing queries Sanity from the browser.
#
# Add the same variable in Vercel's project settings before deploying.
#
# The alternative is to make the dataset public (sanity.io/manage → Datasets),
# which is reasonable for a portfolio, since everything in it is public anyway.
# ---------------------------------------------------------------------------

SANITY_API_READ_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL: instant publishing.
#
# Pages revalidate hourly on their own, so an edit in the Studio can take an
# hour to appear. Setting this enables /api/revalidate, which Sanity calls on
# publish so the change lands in about a second.
#
# Invent any long random string, put the same value in the webhook's Secret
# field at sanity.io/manage → API → Webhooks, and add it in Vercel. Without it
# the route returns 501 and nothing else changes. See the route file for the
# rest of the webhook settings.
# ---------------------------------------------------------------------------

SANITY_REVALIDATE_SECRET=
